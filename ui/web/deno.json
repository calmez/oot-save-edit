{
  "nodeModulesDir": "auto",
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "test": "deno test --config deno.test.json --allow-env",
    "install-deps": "deno install --allow-scripts",
    "dev": "vite",
    "build": "vite build --configLoader native",
    "start": "deno serve -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update ."
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "exclude": [
    "**/_fresh/*"
  ],
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@1",
    "@std/testing": "jsr:@std/testing@1",
    "@opentelemetry/api": "npm:@opentelemetry/api@1.9.0",
    "fresh": "jsr:@fresh/core@2.2.0",
    "fresh/runtime": "jsr:@fresh/core@2.2.0/runtime",
    "preact": "npm:preact@10.28.4",
    "preact/compat/jsx-dev-runtime": "npm:preact@10.28.4/compat/jsx-dev-runtime",
    "preact/hooks": "npm:preact@10.28.4/hooks",
    "preact/jsx-runtime": "npm:preact@10.28.4/jsx-runtime",
    "preact/test-utils": "npm:preact@10.28.4/test-utils",
    "preact-render-to-string": "npm:preact-render-to-string@^6.6.3",
    "@preact/signals": "npm:@preact/signals@2.8.1",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@1.0.8",
    "vite": "npm:vite@7.3.1",
    "tailwindcss": "npm:tailwindcss@4.2.1",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@4.2.1"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": [
      "vite/client"
    ]
  }
}
